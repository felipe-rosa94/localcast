<Window x:Class="LocalCast.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalCast.App"
        Title="LocalCast" Width="720" Height="560" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0B" Foreground="#FAFAFA"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:CountToVisibilityConverter x:Key="ZeroCountToVis" Invert="True" />

        <SolidColorBrush x:Key="Surface" Color="#121214" />
        <SolidColorBrush x:Key="Line" Color="#1F1F23" />
        <SolidColorBrush x:Key="Muted" Color="#8A8A93" />
        <SolidColorBrush x:Key="Faint" Color="#55555C" />
        <SolidColorBrush x:Key="Accent" Color="#4F7DF3" />
        <SolidColorBrush x:Key="Danger" Color="#F26B6B" />
        <SolidColorBrush x:Key="Ok" Color="#4ADE80" />

        <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
            <Grid>
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" />
                <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="9" IsHitTestVisible="False" />
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Hover" Property="Opacity" Value="0.14" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="OutlineDangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
            <Setter Property="BorderBrush" Value="#4A2A2E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="CaretBrush" Value="#FAFAFA" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Descoberta -->
        <Grid Margin="44,36,44,32" Visibility="{Binding IsStreaming, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="LocalCast" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Escolha uma TV para transmitir sua tela." Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Muted}" />
                </StackPanel>
                <Button Content="Atualizar" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRefreshClicked" />
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding DiscoveredTvs.Count, Converter={StaticResource ZeroCountToVis}}">
                    <TextBlock Text="Procurando TVs na rede…" FontSize="15" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Abra o LocalCast TV na televisão, ou digite o IP abaixo." Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DiscoveredTvs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="14" Padding="20,16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Ok}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Fill" Value="#F5A524" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Transmitir" Style="{StaticResource PrimaryButton}"
                                                IsEnabled="{Binding IsAvailable}" Click="OnTvSelectedClicked" Tag="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource Field}" Text="{Binding QuickIpInput, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnQuickIpKeyDown" />
                    <TextBlock Text="IP da TV  (ex.: 192.168.0.25)" Foreground="{StaticResource Faint}" FontSize="14"
                               Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuickIpInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Content="Conectar por IP" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Click="OnQuickConnectClicked" />
            </Grid>
        </Grid>

        <!-- Transmitindo -->
        <Grid Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Transmitindo para" FontSize="13" Foreground="{StaticResource Muted}" />
                </StackPanel>

                <TextBlock Text="{Binding ConnectedTvName}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="{Binding StreamingDuration}" FontSize="64" FontWeight="Light" FontFamily="Segoe UI Light, Segoe UI"
                           HorizontalAlignment="Center" Margin="0,18,0,26" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="{Binding StreamingFps}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="quadros" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="{Binding StreamingBitrate}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="taxa de bits" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding StreamingLatency}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="latência" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button Content="Parar transmissão" Style="{StaticResource OutlineDangerButton}" Padding="26,11"
                        HorizontalAlignment="Center" Click="OnStopStreamingClicked" />
            </StackPanel>
        </Grid>

        <!-- PIN -->
        <Grid x:Name="PairingOverlay" Background="#D9000000" Visibility="{Binding IsPairing, Converter={StaticResource BoolToVis}}"
              IsVisibleChanged="OnPairingVisibleChanged">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20"
                    Width="360" Padding="32,30" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Digite o PIN" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="O código de 4 dígitos aparece na tela da TV." Margin="0,6,0,22" FontSize="13"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" />

                    <TextBox x:Name="PinTextBox" Style="{StaticResource Field}" Text="{Binding PinInput, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="4" FontSize="38" FontWeight="SemiBold" FontFamily="Consolas" HorizontalContentAlignment="Center"
                             InputMethod.IsInputMethodEnabled="False" Padding="12,10"
                             PreviewTextInput="OnPinPreviewTextInput" KeyDown="OnPinKeyDown" />

                    <TextBlock Text="{Binding PairingErrorMessage}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" MinHeight="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PairingErrorMessage}" Value="Conectando...">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="OnCancelPairingClicked" />
                        <Button Grid.Column="1" Content="Conectar" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="OnConfirmPairingClicked" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
